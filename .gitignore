# ==============================================================================
# AquaSentinel — Global .gitignore
# Prevents accidental leaks of credentials, databases, build artifacts, and caches
# ==============================================================================

# --- Secrets, API Keys & Environment Configurations ---
.env
.env.*
*.env
!.env.example
.cdsapirc
*.pem
*.key
*.p12
*.pfx
secrets/

# --- Databases & Persistent Evidence ---
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
spills_database.sqlite3

# --- Generated PDF Reports & Forensic Dossiers ---
backend/reports/*.pdf
*.pdf

# --- Python / Backend Caching & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node.js / Frontend Caching & Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*
dist/
dist-ssr/
*.local

# --- Operating System & IDE Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
